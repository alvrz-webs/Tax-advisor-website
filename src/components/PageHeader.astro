---
interface Props {
	eyebrow: string;
	title: string;
	description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="page-header">
	<div class="container">
		<div class="page-header-inner reveal">
			<p class="eyebrow">{eyebrow}</p>
			<hr class="rule-gold" />
			<h1>{title}</h1>
			{description && <p class="page-header-desc text-dim">{description}</p>}
		</div>
	</div>
</section>

<style>
	.page-header {
		padding-block: 3rem 1rem;
	}

	.page-header-inner {
		max-width: 68ch;
	}

	.page-header-inner h1 {
		font-size: clamp(2rem, 4vw, 2.9rem);
	}

	.page-header-desc {
		font-size: 1.05rem;
		max-width: 58ch;
		margin-block-start: 1.1rem;
	}
</style>
