			},
		],
	},
} as const;

const t = UI[lang];
---

<Layout title={t.title} description={t.description} lang={lang} slug="servicios">
	<PageHeader eyebrow={t.eyebrow} title={t.heading} description={t.intro} />

	<section class="articulado">
		<div class="container">
			<div class="lista reveal">
				{
					t.items.map((item) => (
						<article class="articulo-item">
							<span class="articulo-n">Art. {item.n}</span>
							<div class="articulo-body">
								<h2>{item.t}</h2>
								<p class="text-dim">{item.d}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="cta-final">
		<div class="container cta-final-inner reveal">
			<h2>{t.ctaTitle}</h2>
			<p class="text-dim">{t.ctaText}</p>
			<a href={localizedPath('/contacto', lang)} class="btn btn-primary">{t.ctaBtn}</a>
		</div>
	</section>
</Layout>

<style>
	.articulado {
		padding-block: 1rem 4rem;
	}

	.lista {
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--color-border);
	}

	.articulo-item {
		display: grid;
		grid-template-columns: 6.5rem 1fr;
		gap: 1.75rem;
		padding-block: 2.25rem;
		border-bottom: 1px solid var(--color-border);
	}

	.articulo-n {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--color-gold);
		padding-block-start: 0.25rem;
	}

	.articulo-body h2 {
		font-size: 1.4rem;
		font-weight: 600;
		margin-block-end: 0.6rem;
	}

	.articulo-body p {
		font-size: 1rem;
		line-height: 1.65;
		max-width: 58ch;
	}

	.cta-final {
		border-top: 1px solid var(--color-border);
		padding-block: 4rem;
		background: var(--color-bg-elevated);
	}

	.cta-final-inner {
		max-width: 54ch;
		text-align: center;
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.cta-final-inner h2 {
		font-size: clamp(1.4rem, 3vw, 1.9rem);
	}

	.cta-final-inner .btn {
		margin-block-start: 0.5rem;
	}

	@media (max-width: 620px) {
		.articulo-item {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
	}
</style>
