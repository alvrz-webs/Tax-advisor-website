		description: 'Renta, IVA, autónomos, sucesiones y donaciones, y procedimientos administrativos. Asesoría fiscal en Valencia.',
		eyebrow: 'Áreas de práctica',
		heading: 'En qué puedo ayudarte',
		intro: 'Cinco áreas de trabajo, con el mismo criterio en todas: claridad, rigor y acompañamiento cercano.',
		ctaTitle: '¿Tu caso no encaja exactamente aquí?',
		ctaText: 'Cuéntame tu situación y te digo cómo puedo ayudarte.',
		ctaBtn: 'Contactar',
		items: [
			{
				n: '01',
				t: 'Declaración de la Renta',
				d: 'Preparación y presentación del IRPF, revisando deducciones y bonificaciones para que no pagues de más.',
			},
			{
				n: '02',
				t: 'IVA',
				d: 'Gestión y liquidación trimestral y anual del IVA, con control de plazos y modelos.',
			},
			{
				n: '03',
				t: 'Autónomos',
				d: 'Alta, tributación y obligaciones fiscales recurrentes para trabajadores por cuenta propia.',
			},
			{
				n: '04',
				t: 'Impuesto sobre Sucesiones y Donaciones',
				d: 'Planificación y liquidación en herencias y donaciones, minimizando la carga fiscal dentro de la legalidad.',
			},
			{
				n: '05',
				t: 'Procedimientos Administrativos',
				d: 'Representación y defensa ante requerimientos, comprobaciones e inspecciones de la Agencia Tributaria.',
			},
		],
	},
	en: {
		title: 'Practice areas — Pilar Nieto Pérez',
		description: 'Income tax, VAT, self-employment, inheritance and gift tax, and administrative proceedings. Tax advisory in Valencia.',
		eyebrow: 'Practice areas',
		heading: 'How I can help',
		intro: 'Five areas of work, all built on the same principles: clarity, rigour and close, personal attention.',
		ctaTitle: "Not quite what you're looking for?",
		ctaText: "Tell me about your situation and I'll let you know how I can help.",
		ctaBtn: 'Get in touch',
		items: [
			{
				n: '01',
				t: 'Income Tax Return',
				d: "Preparation and filing of personal income tax (IRPF), reviewing deductions and allowances so you don't overpay.",
			},
			{
				n: '02',
				t: 'VAT',
				d: 'Quarterly and annual VAT management and filing, with full control of deadlines and forms.',
			},
			{
				n: '03',
				t: 'Self-Employed',
				d: 'Registration, taxation and recurring tax obligations for the self-employed.',
			},
			{
				n: '04',
				t: 'Inheritance & Gift Tax',
				d: 'Planning and settlement of inheritance and gift tax, minimising the tax burden within the law.',
			},
			{
				n: '05',
				t: 'Administrative Proceedings',
				d: 'Representation and defence before requests, reviews and inspections from the Tax Agency.',
			},
		],
	},
	ca: {
		title: 'Àrees de pràctica — Pilar Nieto Pérez',
		description: "Renda, IVA, autònoms, successions i donacions, i procediments administratius. Assessoria fiscal a València.",
		eyebrow: 'Àrees de pràctica',
		heading: 'En què et puc ajudar',
		intro: 'Cinc àrees de treball, amb el mateix criteri en totes: claredat, rigor i acompanyament proper.',
		ctaTitle: 'El teu cas no encaixa exactament aquí?',
		ctaText: "Explica'm la teva situació i et diré com et puc ajudar.",
		ctaBtn: 'Contacta',
		items: [
			{
				n: '01',
				t: 'Declaració de la Renda',
				d: "Preparació i presentació de l'IRPF, revisant deduccions i bonificacions perquè no paguis de més.",
			},
			{
				n: '02',
				t: 'IVA',
				d: "Gestió i liquidació trimestral i anual de l'IVA, amb control de terminis i models.",
			},
			{
				n: '03',
				t: 'Autònoms',
				d: 'Alta, tributació i obligacions fiscals recurrents per a treballadors per compte propi.',
			},
			{
				n: '04',
				t: 'Impost sobre Successions i Donacions',
				d: 'Planificació i liquidació en herències i donacions, minimitzant la càrrega fiscal dins de la legalitat.',
			},
			{
				n: '05',
