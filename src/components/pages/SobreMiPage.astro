---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../PageHeader.astro';
import { type Locale } from '../../lib/i18n';

interface Props {
	lang?: Locale;
}

const { lang = 'es' } = Astro.props;

// TODO: si quieres mostrar el nivel de cada idioma (ej. "Español (Nativo)"), añádelo
// en el campo "Idiomas"/"Languages" de cada locale más abajo. Se quitó el (B2) del
// francés para no dejar solo un idioma con nivel indicado y el resto sin él.
const UI = {
	es: {
		title: 'Sobre mí — Pilar Nieto Pérez',
		description: 'Pilar Nieto Pérez, asesora fiscal en Valencia. Rigor técnico y trato cercano en cada expediente.',
		eyebrow: 'Sobre mí',
		heading: 'Asesoramiento fiscal con criterio propio',
		bio: [
			'Soy Pilar Nieto Pérez, asesora fiscal en Valencia. Trabajo con particulares, autónomos y empresas que necesitan algo más que presentar impuestos a tiempo: necesitan entender sus números y tomar decisiones con seguridad.',
			'Mi enfoque combina el rigor técnico con la cercanía: explico cada gestión en términos claros, sin tecnicismos innecesarios, y me implico en cada expediente como si fuera el único que llevo.',
			'Atiendo tanto trámites recurrentes —renta, IVA, autónomos— como situaciones más delicadas: sucesiones y donaciones, o procedimientos administrativos ante la Agencia Tributaria.',
		],
		facts: [
			{ label: 'Sede', value: 'Valencia' },
			{ label: 'Idiomas', value: 'Español · Francés · English · Русский' },
			{ label: 'Enfoque', value: 'Fiscalidad de particulares y empresas' },
			{ label: 'Disponibilidad', value: 'Nuevos clientes bienvenidos' },
		],
		formacion: {
			heading: 'Formación y experiencia',
			academicTitle: 'Formación académica',
			professionalTitle: 'Experiencia profesional',
			academic: [
				{
					period: '2020–2025',
					title: 'Doble Grado en Derecho y Criminología',
					place: 'Universitat de València',
					status: null,
				},
				{
					period: '2025',
					title: 'Experto en Fiscalidad Internacional',
					place: 'Universitat de València',
					status: null,
				},
				{
					period: '2025–2026',
					title: 'Máster en Asesoría Fiscal y Tributación',
					place: 'Centro de Estudios Financieros (CEF)',
					status: null,
				},
				{
					period: '2026',
					title: 'Doble Máster en Abogacía y Derecho de la Empresa',
					place: 'Universitat de València',
					status: { label: 'En curso', kind: 'ongoing' },
				},
			],
			professional: [
				{
					period: 'Ago 2024 – Sep 2024',
					title: 'Verificación contable y cumplimiento normativo',
					place: 'C.B. Registro Mercantil de Valencia',
					description:
						'Verificación de balances, cuentas de pérdidas y ganancias y memorias, detectando discrepancias técnicas para asegurar el cumplimiento normativo en el depósito de cuentas anuales.',
				},
				{
					period: 'Nov 2025 – Julio 2026',
					title: 'Becaria de fiscalidad',
					place: 'Martínez Ojeda y Asociados — Asesoría Legal, Financiera y Tributaria Internacional S.L.',
					description:
						'Gestión fiscal de la cartera de clientes, presentación de modelos tributarios de la AEAT, y respuesta a requerimientos y alegaciones ante la Agencia Tributaria (IVA, IRPF y residencia, entre otros).',
				},
			],
		},
	},
	en: {
		title: 'The firm — Pilar Nieto Pérez',
		description: 'Pilar Nieto Pérez, tax advisor in Valencia. Technical rigour and a personal touch in every case.',
		eyebrow: 'The firm',
		heading: 'Tax advice with a clear point of view',
		bio: [
			"I'm Pilar Nieto Pérez, a tax advisor based in Valencia. I work with individuals, self-employed professionals and businesses who need more than their taxes filed on time - they need to understand their numbers and make decisions with confidence.",
			'My approach combines technical rigour with a personal touch: I explain every step in plain language, without unnecessary jargon, and treat every case as if it were the only one I\u2019m handling.',
			'I handle recurring filings — income tax, VAT, self-employment — as well as more delicate matters: inheritance and gift tax, and administrative proceedings before the Tax Agency.',
		],
		facts: [
			{ label: 'Based in', value: 'Valencia, Spain' },
			{ label: 'Languages', value: 'Spanish · French · English · Russian' },
			{ label: 'Focus', value: 'Tax advice for individuals and businesses' },
			{ label: 'Availability', value: 'New clients welcome' },
		],
		formacion: {
			heading: 'Education and experience',
			academicTitle: 'Academic background',
			professionalTitle: 'Professional experience',
			academic: [
				{
					period: '2020–2025',
					title: 'Dual Degree in Law and Criminology',
					place: 'Universitat de València',
					status: null,
				},
				{
					period: '2025',
					title: 'Expert in International Taxation',
					place: 'Universitat de València',
					status: null,
				},
				{
					period: '2025–2026',
					title: "Master's Degree in Tax Advisory and Taxation",
					place: 'Centro de Estudios Financieros (CEF)',
					status: null,
				},
				{
					period: '2026',
					title: "Dual Master's Degree in Legal Practice and Corporate Law",
					place: 'Universitat de València',
					status: { label: 'Ongoing', kind: 'ongoing' },
				},
			],
			professional: [
				{
					period: 'Aug 2024 – Sep 2024',
					title: 'Accounting review and regulatory compliance',
					place: 'C.B. Registro Mercantil de Valencia',
					description:
						'Reviewed balance sheets, profit and loss accounts and annual reports, identifying technical discrepancies to ensure regulatory compliance when filing annual accounts.',
				},
				{
					period: 'Nov 2025 – July 2026',
					title: 'Tax intern',
					place: 'Martínez Ojeda y Asociados — Asesoría Legal, Financiera y Tributaria Internacional S.L.',
					description:
						'Managing the tax affairs of a client portfolio, filing tax returns with the Spanish Tax Agency (AEAT), and responding to information requests and appeals before the Tax Agency (VAT, personal income tax and tax residency, among others).',
				},
			],
		},
	},
	ca: {
		title: 'La firma — Pilar Nieto Pérez',
		description: "Pilar Nieto Pérez, assessora fiscal a València. Rigor tècnic i tracte proper en cada expedient.",
		eyebrow: 'La firma',
		heading: 'Assessorament fiscal amb criteri propi',
		bio: [
			"Sóc Pilar Nieto Pérez, assessora fiscal a València. Treballo amb particulars, autònoms i empreses que necessiten alguna cosa més que presentar els impostos a temps: necessiten entendre els seus números i prendre decisions amb seguretat.",
			"El meu enfocament combina el rigor tècnic amb la proximitat: explico cada gestió en termes clars, sense tecnicismes innecessaris, i m'implico en cada expedient com si fos l'únic que porto.",
			"Atenc tant tràmits recurrents —renda, IVA, autònoms— com situacions més delicades: successions i donacions, o procediments administratius davant l'Agència Tributària.",
		],
		facts: [
			{ label: 'Seu', value: 'València' },
			{ label: 'Idiomes', value: 'Espanyol · Francès · English · Русский' },
			{ label: 'Enfocament', value: 'Fiscalitat de particulars i empreses' },
			{ label: 'Disponibilitat', value: 'Nous clients benvinguts' },
		],
		formacion: {
			heading: 'Formació i experiència',
			academicTitle: 'Formació acadèmica',
			professionalTitle: 'Experiència professional',
			academic: [
				{
					period: '2020–2025',
					title: 'Doble Grau en Dret i Criminologia',
					place: 'Universitat de València',
					status: null,
				},
				{
					period: '2025',
					title: 'Expert en Fiscalitat Internacional',
					place: 'Universitat de València',
					status: null,
				},
				{
					period: '2025–2026',
					title: 'Màster en Assessoria Fiscal i Tributació',
					place: 'Centro de Estudios Financieros (CEF)',
					status: null,
				},
				{
					period: '2026',
					title: "Doble Màster en Advocacia i Dret de l'Empresa",
					place: 'Universitat de València',
					status: { label: 'En curs', kind: 'ongoing' },
				},
			],
			professional: [
				{
					period: 'Ago 2024 – Set 2024',
					title: 'Verificació comptable i compliment normatiu',
					place: 'C.B. Registro Mercantil de Valencia',
					description:
						"Verificació de balanços, comptes de pèrdues i guanys i memòries, detectant discrepàncies tècniques per assegurar el compliment normatiu en el dipòsit de comptes anuals.",
				},
				{
					period: 'Nov 2025 – Juliol 2026',
					title: 'Becària de fiscalitat',
					place: 'Martínez Ojeda y Asociados — Asesoría Legal, Financiera y Tributaria Internacional S.L.',
					description:
						"Gestió fiscal de la cartera de clients, presentació de models tributaris de l'AEAT, i resposta a requeriments i al·legacions davant l'Agència Tributària (IVA, IRPF i residència, entre altres).",
				},
			],
		},
	},
	ru: {
		title: 'О фирме — Пилар Ньето Перес',
		description: 'Пилар Ньето Перес, налоговый консультант в Валенсии. Техническая точность и личное внимание к каждому делу.',
		eyebrow: 'О фирме',
		heading: 'Налоговое консультирование с чёткой позицией',
		bio: [
			'Меня зовут Пилар Ньето Перес, я налоговый консультант в Валенсии. Работаю с частными лицами, самозанятыми и компаниями, которым важно не просто вовремя подать декларацию, а понимать свои цифры и принимать решения с уверенностью.',
			'Мой подход сочетает техническую точность с личным вниманием: я объясняю каждый шаг простым языком, без лишних терминов, и веду каждое дело так, как будто оно единственное.',
			'Я занимаюсь как регулярными вопросами — подоходный налог, НДС, самозанятость, — так и более деликатными: налог на наследство и дарение, а также административные процедуры в налоговой инспекции.',
		],
		facts: [
			{ label: 'Город', value: 'Валенсия' },
			{ label: 'Языки', value: 'испанский · французский · английский · русский' },
			{ label: 'Специализация', value: 'налоги для частных лиц и компаний' },
			{ label: 'Приём клиентов', value: 'открыт для новых клиентов' },
		],
		formacion: {
			heading: 'Образование и опыт',
			academicTitle: 'Образование',
			professionalTitle: 'Профессиональный опыт',
			academic: [
				{
					period: '2020–2025',
					title: 'Двойная степень по праву и криминологии',
					place: 'Universitat de València',
					status: null,
				},
				{
					period: '2025',
					title: 'Эксперт по международному налогообложению',
					place: 'Universitat de València',
					status: null,
				},
				{
					period: '2025–2026',
					title: 'Магистратура по налоговому консультированию и налогообложению',
					place: 'Centro de Estudios Financieros (CEF)',
					status: null,
				},
				{
					period: '2026',
					title: 'Двойная магистратура по адвокатской практике и предпринимательскому праву',
					place: 'Universitat de València',
					status: { label: 'Продолжается', kind: 'ongoing' },
				},
			],
			professional: [
				{
					period: 'авг 2024 – сен 2024',
					title: 'Проверка бухгалтерской отчётности и соответствия нормативным требованиям',
					place: 'C.B. Registro Mercantil de Valencia',
					description:
						'Проверка балансов, отчётов о прибылях и убытках и пояснительных записок с выявлением технических несоответствий для обеспечения соответствия нормативным требованиям при подаче годовой отчётности.',
				},
				{
					period: 'ноя 2025 – июль 2026',
					title: 'Стажёр по налогообложению',
					place: 'Martínez Ojeda y Asociados — Asesoría Legal, Financiera y Tributaria Internacional S.L.',
					description:
						'Налоговое сопровождение портфеля клиентов, подача налоговых деклараций в Налоговое агентство Испании (AEAT), а также ответы на запросы и возражения в Налоговом агентстве (НДС, НДФЛ, налоговое резидентство и др.).',
				},
			],
		},
	},
} as const;

const t = UI[lang];
---

<Layout title={t.title} description={t.description} lang={lang} slug="sobre-mi">
	<PageHeader eyebrow={t.eyebrow} title={t.heading} />

	<section class="bio">
		<div class="container">
			<div class="bio-grid">
				<div class="bio-media reveal">
					<picture>
						<source srcset="/pilar-nieto.webp" type="image/webp" />
						<img
							src="/pilar-nieto.jpg"
							width="900"
							height="1200"
							alt="Retrato de Pilar Nieto Pérez, asesora fiscal en Valencia"
							loading="eager"
							decoding="async"
						/>
					</picture>
				</div>
				<div class="bio-text reveal">
					{t.bio.map((p) => <p>{p}</p>)}
				</div>
			</div>

			<div class="facts-row reveal">
				{
					t.facts.map((fact) => (
						<div class="fact-card">
							<p class="fact-label">{fact.label}</p>
							<p class="fact-value">{fact.value}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="formacion">
		<div class="container">
			<h2 class="formacion-heading reveal">{t.formacion.heading}</h2>

			<div class="formacion-grid">
				<div class="formacion-col reveal">
					<h3 class="formacion-subheading">{t.formacion.academicTitle}</h3>
					<ul class="timeline">
						{
							t.formacion.academic.map((item) => (
								<li class="timeline-item">
									<p class="timeline-period">{item.period}</p>
									<div class="timeline-content">
										<p class="timeline-title">{item.title}</p>
										<p class="timeline-place text-dim">{item.place}</p>
										{item.status && (
											<span class={`timeline-status timeline-status--${item.status.kind}`}>
												{item.status.label}
											</span>
										)}
									</div>
								</li>
							))
						}
					</ul>
				</div>

				<div class="formacion-col reveal">
					<h3 class="formacion-subheading">{t.formacion.professionalTitle}</h3>
					<ul class="timeline">
						{
							t.formacion.professional.map((item) => (
								<li class="timeline-item">
									<p class="timeline-period">{item.period}</p>
									<div class="timeline-content">
										<p class="timeline-title">{item.title}</p>
										<p class="timeline-place text-dim">{item.place}</p>
										<p class="timeline-desc text-dim">{item.description}</p>
									</div>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.bio {
		padding-block: 1rem 6rem;
	}

	.bio-grid {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: clamp(2rem, 4vw, 3.25rem);
		align-items: start;
		margin-block-end: 3rem;
	}

	.bio-media {
		position: relative;
	}

	.bio-media img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 4px;
		border: 1px solid var(--color-border);
		box-shadow: 0 22px 45px -30px rgba(22, 37, 60, 0.5);
	}

	.bio-text {
		max-width: 62ch;
		margin-block-end: 0;
	}

	.bio-text p {
		font-size: 1.04rem;
		line-height: 1.75;
		color: var(--color-text-dim);
	}

	.bio-text p + p {
		margin-block-start: 1.25rem;
	}

	.facts-row {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.fact-card {
		flex: 1 1 220px;
		background: var(--color-bg-elevated);
		border: 1px solid var(--color-border);
		border-inline-start: 2px solid var(--color-gold);
		padding: 1.1rem 1.3rem;
	}

	.fact-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-gold-text);
		margin-block-end: 0.4rem;
	}

	.fact-value {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 1rem;
	}

	@media (max-width: 760px) {
		.bio-grid {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.bio-media {
			max-width: 320px;
		}
	}

	.formacion {
		padding-block: 1rem 6rem;
		border-top: 1px solid var(--color-border);
	}

	.formacion-heading {
		font-size: 1.6rem;
		margin-block-end: 2.25rem;
	}

	.formacion-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 4vw, 3.25rem);
		align-items: start;
	}

	.formacion-subheading {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-gold-text);
		margin-block-end: 1.25rem;
	}

	.timeline {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 1.4rem;
	}

	.timeline-item {
		display: grid;
		grid-template-columns: 7.75rem 1fr;
		gap: 0.2rem 1.25rem;
		border-inline-start: 2px solid var(--color-gold);
		padding-inline-start: 1.1rem;
	}

	.timeline-period {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		letter-spacing: 0.03em;
		color: var(--color-text-dim);
		padding-block-start: 0.15rem;
	}

	.timeline-content {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	.timeline-title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.02rem;
	}

	.timeline-place {
		font-size: 0.92rem;
	}

	.timeline-status {
		display: inline-block;
		margin-block-start: 0.55rem;
		padding: 0.22rem 0.65rem;
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		line-height: 1.4;
	}

	.timeline-status--done {
		background: color-mix(in srgb, var(--color-gold) 14%, var(--color-bg-elevated));
		color: var(--color-gold-text);
		border: 1px solid color-mix(in srgb, var(--color-gold) 45%, transparent);
	}

	.timeline-status--ongoing {
		background: color-mix(in srgb, var(--color-ink) 6%, var(--color-bg-elevated));
		color: var(--color-ink);
		border: 1px solid var(--color-border);
	}

	.timeline-desc {
		font-size: 0.92rem;
		line-height: 1.6;
		margin-block-start: 0.25rem;
	}

	@media (max-width: 560px) {
		.timeline-item {
			grid-template-columns: 1fr;
			gap: 0.35rem;
		}
	}

	@media (max-width: 760px) {
		.formacion-grid {
			grid-template-columns: 1fr;
			gap: 2.25rem;
		}
	}
</style>
