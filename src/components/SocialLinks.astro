---
import mailIcon from '../icons/mail.svg?raw';
import linkedinIcon from '../icons/linkedin.svg?raw';

interface Props {
	email: string;
	linkedin: string;
	ariaLabel: string;
	emailLabel: string;
	linkedinLabel: string;
}

const { email, linkedin, ariaLabel, emailLabel, linkedinLabel } = Astro.props;
---

<div class="social-links" aria-label={ariaLabel}>
	<a href={`mailto:${email}`} class="social-badge" aria-label={emailLabel} title={emailLabel}>
		<span class="social-badge-icon" set:html={mailIcon} />
	</a>
	<a
		href={linkedin}
		target="_blank"
		rel="noopener noreferrer"
		class="social-badge"
		aria-label={linkedinLabel}
		title={linkedinLabel}
	>
		<span class="social-badge-icon" set:html={linkedinIcon} />
	</a>
</div>

<style>
	.social-links {
		display: flex;
		gap: 0.6rem;
	}

	.social-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border-radius: 8px;
		border: 1px solid var(--color-border);
		background: transparent;
		color: var(--color-ink);
		transition:
			border-color var(--transition-fast),
			color var(--transition-fast),
			transform var(--transition-fast);
	}

	.social-badge-icon :global(svg) {
		width: 18px;
		height: 18px;
		display: block;
	}

	.social-badge:hover {
		border-color: var(--color-gold);
		color: var(--color-gold-text);
		transform: translateY(-2px);
	}
</style>
