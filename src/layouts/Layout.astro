---
import '../styles/global.css';
import { type Locale, localizedPath, strings } from '../lib/i18n';
import SocialLinks from '../components/SocialLinks.astro';

interface Props {
	title: string;
	description: string;
	lang: Locale;
	/** Slug de la página actual sin idioma delante, p.ej. '', 'sobre-mi', 'servicios', 'contacto' */
	slug?: string;
	noindex?: boolean;
}

const { title, description, lang, slug = '', noindex = false } = Astro.props;
const t = strings[lang];

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
const ogLocaleMap = { es: 'es_ES', en: 'en_GB', ca: 'ca_ES', ru: 'ru_RU' } as const;
const ogLocale = ogLocaleMap[lang];

const navLinks = [
	{ href: localizedPath('/sobre-mi', lang), label: t.nav.laFirma, key: 'sobre-mi' },
	{ href: localizedPath('/servicios', lang), label: t.nav.servicios, key: 'servicios' },
	{ href: localizedPath('/contacto', lang), label: t.nav.contacto, key: 'contacto' },
];

const langLinks = [
	{ code: 'es', label: 'ES', href: slug ? `/${slug}` : '/' },
	{ code: 'en', label: 'EN', href: slug ? `/en/${slug}` : '/en' },
	{ code: 'ca', label: 'CA', href: slug ? `/ca/${slug}` : '/ca' },
	{ code: 'ru', label: 'RU', href: slug ? `/ru/${slug}` : '/ru' },
] as const;

const hreflangLinks = langLinks.map((l) => ({
	code: l.code,
	href: new URL(l.href, Astro.site).toString(),
}));
const xDefaultHref = hreflangLinks.find((l) => l.code === 'es')!.href;

const linkedinURL = 'https://www.linkedin.com/in/pilar-nieto-pérez-020b0320a';
const homeURL = new URL('/', Astro.site).toString();
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Pilar Nieto Pérez — Asesoría Fiscal',
	url: homeURL,
	description,
	image: ogImage.toString(),
	sameAs: [linkedinURL],
	areaServed: 'Valencia, España',
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex,nofollow" />}
		<link rel="canonical" href={canonicalURL} />

		{
			hreflangLinks.map((l) => (
				<link rel="alternate" hreflang={l.code} href={l.href} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={xDefaultHref} />

		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#16253c" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="Pilar Nieto Pérez — Asesora Fiscal" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Pilar Nieto Pérez — Asesoría Fiscal" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Public+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>

		<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<header id="site-header">
			<div class="container nav-inner">
				<a href={localizedPath('/', lang)} class="brand" aria-label="Pilar Nieto Pérez — Asesoría Fiscal">
					<img class="brand-mark" src="/logo-mark.png" alt="" width="40" height="40" decoding="async" />
					<span class="brand-name">Pilar Nieto <em>Pérez</em></span>
				</a>

				<nav id="site-nav" aria-label={t.nav.ariaMain}>
					<ul>
						{
							navLinks.map((link) => (
								<li>
									<a href={link.href} aria-current={slug === link.key ? 'page' : undefined}>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				<div class="nav-actions">
					<div class="lang-switch" aria-label={t.langSwitch.label}>
						{
							langLinks.map((l) => (
								<a href={l.href} aria-current={lang === l.code ? 'true' : undefined}>
									{l.label}
								</a>
							))
						}
					</div>
					<a href={localizedPath('/contacto', lang)} class="btn btn-primary btn-nav">
						{t.nav.contacto}
					</a>
					<button id="nav-toggle" aria-label={t.nav.openMenu} aria-expanded="false" aria-controls="site-nav">
						<span></span>
						<span></span>
						<span></span>
					</button>
				</div>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer>
			<div class="container footer-inner">
				<div class="footer-brand">
					<img class="footer-mark" src="/logo-mark.png" alt="" width="46" height="46" loading="lazy" decoding="async" />
					<p class="footer-name">Pilar Nieto Pérez</p>
					<p class="text-dim">{t.footer.tagline}</p>
					<SocialLinks
						email="pilarnietop@outlook.com"
						linkedin="https://www.linkedin.com/in/pilar-nieto-pérez-020b0320a"
						ariaLabel={t.footer.ariaSocial}
						emailLabel={t.footer.emailLabel}
						linkedinLabel={t.footer.linkedinLabel}
					/>
				</div>

				<div class="footer-links">
					<a href={localizedPath('/aviso-legal', lang)}>{t.footer.avisoLegal}</a>
				</div>
			</div>
			<div class="container">
				<p class="footer-copy text-dim">{t.footer.copy(new Date().getFullYear())}</p>
			</div>
		</footer>

		<script>
			const toggle = document.getElementById('nav-toggle');
			const nav = document.getElementById('site-nav');

			toggle?.addEventListener('click', () => {
				const isOpen = nav?.classList.toggle('is-open');
				toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
			});

			nav?.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => {
					nav.classList.remove('is-open');
					toggle?.setAttribute('aria-expanded', 'false');
				});
			});

			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const revealEls = document.querySelectorAll('.reveal');

			if (prefersReducedMotion || !('IntersectionObserver' in window)) {
				revealEls.forEach((el) => el.classList.add('is-visible'));
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
				);

				revealEls.forEach((el) => observer.observe(el));
			}
		</script>
	</body>
</html>

<style>
	#site-header {
		position: sticky;
		inset-block-start: 0;
		z-index: 100;
		background: color-mix(in srgb, var(--color-bg) 88%, transparent);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--color-border);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 1rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		color: var(--color-ink);
	}

	.brand-mark {
		width: 40px;
		height: 40px;
		object-fit: contain;
		flex-shrink: 0;
	}

	.brand-name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.02rem;
	}

	.brand-name em {
		font-style: italic;
		color: var(--color-gold-text);
	}

	#site-nav ul {
		display: flex;
		align-items: center;
		gap: 2rem;
		list-style: none;
	}

	#site-nav a {
		text-decoration: none;
		color: var(--color-text-dim);
		font-size: 0.9rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		transition: color var(--transition-fast);
	}

	#site-nav a:hover {
		color: var(--color-ink);
	}

	#site-nav a[aria-current='page'] {
		color: var(--color-ink);
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.lang-switch {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-text-dim);
	}

	.lang-switch a {
		text-decoration: none;
		color: var(--color-text-dim);
		transition: color var(--transition-fast);
	}

	.lang-switch a[aria-current='true'] {
		color: var(--color-ink);
		font-weight: 600;
	}

	.lang-switch a:hover {
		color: var(--color-ink);
	}

	.btn-nav {
		padding: 0.6rem 1.15rem;
		font-size: 0.85rem;
	}

	#nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 38px;
		height: 38px;
		background: transparent;
		border: 1px solid var(--color-border);
		cursor: pointer;
	}

	#nav-toggle span {
		display: block;
		height: 1.5px;
		margin-inline: 8px;
		background: var(--color-ink);
		transition: transform var(--transition-fast), opacity var(--transition-fast);
	}

	footer {
		border-top: 1px solid var(--color-border);
		padding-block: 3rem 1.5rem;
		margin-block-start: 4rem;
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1.5rem;
		padding-block-end: 1.75rem;
	}

	.footer-mark {
		width: 46px;
		height: 46px;
		object-fit: contain;
		margin-block-end: 0.7rem;
	}

	.footer-name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.05rem;
		margin-block-end: 0.3rem;
	}

	.footer-brand :global(.social-links) {
		margin-block-start: 0.9rem;
	}

	.footer-links {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		text-align: right;
		font-size: 0.9rem;
	}

	.footer-links a {
		text-decoration: none;
		color: var(--color-text-dim);
		transition: color var(--transition-fast);
	}

	.footer-links a:hover {
		color: var(--color-ink);
	}

	.footer-copy {
		font-size: 0.8rem;
		border-top: 1px solid var(--color-border);
		padding-block-start: 1.25rem;
	}

	@media (max-width: 820px) {
		#site-nav {
			position: fixed;
			inset-block-start: 66px;
			inset-inline: 0;
			background: color-mix(in srgb, var(--color-bg) 98%, transparent);
			backdrop-filter: blur(10px);
			border-bottom: 1px solid var(--color-border);
			transform: translateY(-8px);
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transition:
				opacity var(--transition-fast),
				transform var(--transition-fast),
				visibility var(--transition-fast);
		}

		#site-nav.is-open {
			opacity: 1;
			transform: translateY(0);
			visibility: visible;
			pointer-events: auto;
		}

		#site-nav ul {
			flex-direction: column;
			align-items: flex-start;
			gap: 0;
			padding: 1rem 1.5rem 1.5rem;
		}

		#site-nav ul li {
			width: 100%;
			border-bottom: 1px solid var(--color-border);
		}

		#site-nav a {
			display: block;
			padding: 0.9rem 0;
		}

		.btn-nav {
			display: none;
		}

		#nav-toggle {
			display: flex;
		}

		.footer-inner {
			flex-direction: column;
		}

		.footer-links {
			text-align: left;
		}
	}
</style>
